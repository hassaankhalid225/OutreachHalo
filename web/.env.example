# =============================================================================
# Frontend environment — copy this file to `web/.env.local`
#
# You can leave EVERYTHING below blank. With an empty file the app runs in demo
# mode: any email + password signs you in, and the dashboard is served from the
# built-in seeded store. Fill these in when you want real auth and a real
# database.
#
# NEXT_PUBLIC_* variables are compiled into the browser bundle — never put a
# secret in one.
# =============================================================================


# --- Required in production, optional locally --------------------------------

# Your public site URL. Used for canonical tags, OG tags, sitemap.xml and
# robots.txt. Set this to the real domain before you deploy or your SEO tags
# will point at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Supabase — set BOTH to switch on real authentication --------------------
# Where: supabase.com → your project → Settings → API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon / public" key  (safe for the browser)
#
# Leave both blank to stay in demo mode. Setting only one has no effect —
# the app checks for both.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# --- Backend — set to move data off the in-memory store ----------------------
# Server-side only (no NEXT_PUBLIC_ prefix), so it is never exposed to the
# browser. Points at the FastAPI service in ../api.
#   Local:      http://127.0.0.1:8000
#   Production: https://your-api.up.railway.app
#
# Leave blank and every read/write stays in the demo store.

API_BASE_URL=
