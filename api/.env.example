# =============================================================================
# Backend environment — copy this file to `api/.env`
#
# The API starts with none of these set; `GET /health` reports which
# integrations are live. Each block below is independently optional, so you can
# turn things on one at a time.
# =============================================================================


# --- App ---------------------------------------------------------------------

ENVIRONMENT=development
APP_URL=http://localhost:3000

# Comma-separated origins allowed to call this API. Add your deployed frontend
# domain here or the browser will block requests.
CORS_ORIGINS=http://localhost:3000


# --- Database — REQUIRED for every /api endpoint -----------------------------
# Where: supabase.com → your project → Settings → Database → Connection string → URI
#        (use the "Session pooler" URI if you deploy somewhere serverless)
#
# Running the bundled Postgres instead (`docker compose up -d db`):
#   postgresql://outreachhalo:outreachhalo@localhost:54322/outreachhalo
#
# Remember to run supabase/migrations/*.sql against it first.

DATABASE_URL=


# --- Supabase Auth — REQUIRED to authenticate anything -----------------------
# The API verifies the access token the frontend sends. Without the JWT secret
# every authenticated endpoint returns 503.
#
# Where: supabase.com → your project → Settings → API
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" key — SECRET, backend only
#   SUPABASE_JWT_SECRET       = JWT Settings → "JWT Secret"

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=


# --- AI provider — powers every AI feature -----------------------------------
# Two providers are supported behind one interface. Switching between them is an
# environment change only: same prompts, same endpoints, no code edits.
#
#   AI_PROVIDER=auto       uses Anthropic if its key is set, otherwise Gemini
#   AI_PROVIDER=gemini     forces Gemini even when an Anthropic key is present
#   AI_PROVIDER=anthropic  forces Anthropic
#
# With neither key set: website analysis, AI replies, post generation and the
# public free tools return 503, and the frontend falls back to its built-in
# composer — which the UI labels honestly rather than passing off as model output.

AI_PROVIDER=auto

# Gemini — aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=1500


# --- Stripe — optional, test mode ---------------------------------------------
# Without these, changing plan updates the workspace directly instead of opening
# Checkout, and the invoice table shows representative test rows.
#
# Where: dashboard.stripe.com (keep the "Test mode" toggle ON)
#   STRIPE_SECRET_KEY     = Developers → API keys → Secret key (sk_test_...)
#   STRIPE_PRICE_PRO      = Products → Pro → your price → "API ID" (price_...)
#   STRIPE_PRICE_GROWTH   = Products → Growth → your price → "API ID"
#   STRIPE_WEBHOOK_SECRET = run: stripe listen --forward-to localhost:8000/api/billing/webhook
#                           and copy the whsec_... it prints

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=


# --- Website-analysis scraper bounds -----------------------------------------

SCRAPE_TIMEOUT_SECONDS=12
SCRAPE_MAX_CHARS=12000
