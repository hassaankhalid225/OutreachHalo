# =============================================================================
# OutreachHalo — every environment variable the project reads.
#
# Copy to `.env` at the repo root (used by docker-compose), and to `web/.env.local`
# and `api/.env` for running the two services directly.
#
# NOTHING here is required to run the project. With an empty .env the frontend
# starts in demo mode: real UI, real interactions, seeded in-memory data.
# =============================================================================


# -----------------------------------------------------------------------------
# Frontend — web/.env.local  (NEXT_PUBLIC_* are exposed to the browser)
# -----------------------------------------------------------------------------

# Public site URL. Used for canonical tags, OG tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project. Setting BOTH of these switches the app out of demo mode and
# turns on real authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend. Server-side only — never exposed to the browser.
# Unset means the frontend serves data from its in-memory store instead.
API_BASE_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# Backend — api/.env
# -----------------------------------------------------------------------------

ENVIRONMENT=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Postgres connection string.
#   Supabase:      Project Settings → Database → Connection string (URI)
#   docker-compose: postgresql://outreachhalo:outreachhalo@localhost:54322/outreachhalo
DATABASE_URL=

# Supabase Auth. The JWT secret is what the API uses to verify access tokens.
#   Project Settings → API → JWT Settings → JWT Secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Anthropic. Owned by the backend only — the frontend never sees this key.
# Without it, AI endpoints return 503 and the frontend falls back to its
# built-in composer (clearly labelled in the UI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=1500

# Stripe (test mode). Without these, plan changes are applied directly to the
# workspace instead of opening Checkout, and the invoice table shows test rows.
#   Price IDs: Stripe Dashboard → Products → your price → "API ID" (price_...)
#   Webhook secret: `stripe listen --forward-to localhost:8000/api/billing/webhook`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=

# Website-analysis scraper bounds.
SCRAPE_TIMEOUT_SECONDS=12
SCRAPE_MAX_CHARS=12000
